# Solo desarrollo local/Replit: el frontend reescribe /api/* hacia este backend
# para mantener las cookies del panel en el mismo origen.
# En Vercel no se define: el enrutamiento /api/* lo hace vercel.json.
BACKEND_URL=http://localhost:8000

# Raíz del API que usan las llamadas del navegador.
# Por defecto /api (mismo origen). Para llamar al backend directamente sin el
# proxy de Next.js, por ejemplo: http://localhost:8000/api
NEXT_PUBLIC_API_URL=/api
