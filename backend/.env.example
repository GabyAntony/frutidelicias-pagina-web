# Copia este archivo a `.env` (en la carpeta backend/) y rellena los valores.
# En Replit, define estas mismas variables en el panel "Secrets".

# OBLIGATORIA. Firma la cookie de sesión del panel. Sin ella el panel queda
# deshabilitado. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria

# Acceso al panel /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=elige-una-contraseña-robusta

# Telegram (opcional pero recomendado). Solo servidor, nunca en el frontend.
# Ver el README para obtenerlos con @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistencia. Relativa a la carpeta backend/.
DATABASE_URL=sqlite:///./data/fruti.db

# Orígenes permitidos (CORS). Incluye tu URL de Replit, p. ej.
# https://fruti-delicias-tu-usuario.replit.app
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# En producción (HTTPS) ponlo en true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
