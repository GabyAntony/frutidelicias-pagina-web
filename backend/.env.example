# Copia este archivo a `.env` (en la carpeta backend/) y rellena los valores.
# En Replit, define estas mismas variables en el panel "Secrets".

# OBLIGATORIA. Firma la cookie de sesión del panel. Sin ella el panel queda
# deshabilitado. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria

# Acceso al panel /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=elige-una-contraseña-robusta

# Telegram (opcional pero recomendado). Solo servidor, nunca en el frontend.
# Ver el README para obtenerlos con @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistencia. Postgres local (docker compose up -d db).
# En Vercel usa la URL del Postgres gestionado (Neon/Vercel Postgres).
# SQLite queda solo como alternativa para pruebas:
#   DATABASE_URL=sqlite:///./data/fruti.db
DATABASE_URL=postgresql+psycopg://fruti:fruti@localhost:5432/fruti

# Orígenes permitidos (CORS). Incluye tu URL de Replit o de Vercel, p. ej.
# https://fruti-delicias-tu-usuario.replit.app
# En Vercel, el navegador llama a /api/* en el mismo dominio, pero conviene
# declarar el dominio público del proyecto.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# En producción (HTTPS) ponlo en true. En Vercel debe ser true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
